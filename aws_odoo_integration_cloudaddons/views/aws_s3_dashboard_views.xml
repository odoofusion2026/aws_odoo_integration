<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aws_s3_dashboard_form" model="ir.ui.view">
        <field name="name">aws.s3.dashboard.form</field>
        <field name="model">aws.s3.dashboard</field>
        <field name="arch" type="xml">
            <form string="AWS S3 Monitoring Dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <field name="kpi_card_html" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server Action to open dashboard with a new transient record -->
    <record id="action_aws_s3_dashboard_server" model="ir.actions.server">
        <field name="name">AWS S3 Dashboard</field>
        <field name="model_id" ref="model_aws_s3_dashboard"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_open_dashboard()
        </field>
    </record>
</odoo>
