<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aws_s3_log_tree" model="ir.ui.view">
        <field name="name">aws.s3.log.list</field>
        <field name="model">aws.s3.log</field>
        <field name="arch" type="xml">
            <list string="AWS S3 Sync Activity Logs" create="false" edit="false" delete="false">
                <field name="create_date" string="Timestamp"/>
                <field name="name" string="Operation"/>
                <field name="attachment_name"/>
                <field name="res_model" string="Odoo Model"/>
                <field name="res_id" string="Record ID"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_aws_s3_log_form" model="ir.ui.view">
        <field name="name">aws.s3.log.form</field>
        <field name="model">aws.s3.log</field>
        <field name="arch" type="xml">
            <form string="AWS S3 Sync Activity Log" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Operation Audit">
                            <field name="create_date" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                        <group string="Object Details">
                            <field name="attachment_name" readonly="1"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="s3_key" readonly="1"/>
                        </group>
                    </group>
                    <group string="Details &amp; Traceback">
                        <field name="message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aws_s3_log_search" model="ir.ui.view">
        <field name="name">aws.s3.log.search</field>
        <field name="model">aws.s3.log</field>
        <field name="arch" type="xml">
            <search string="Search Activity Logs">
                <field name="name"/>
                <field name="attachment_name"/>
                <field name="res_model"/>
                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <group name="group_by">
                    <filter string="Operation" name="group_by_name" context="{'group_by': 'name'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Odoo Model" name="group_by_model" context="{'group_by': 'res_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aws_s3_log" model="ir.actions.act_window">
        <field name="name">Activity Logs Terminal</field>
        <field name="res_model">aws.s3.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_aws_s3_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                AWS S3 Sync Operations Terminal.
            </p>
        </field>
    </record>
</odoo>
